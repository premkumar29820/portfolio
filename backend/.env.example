# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Port the API runs on locally (hosts like Render set this automatically)
PORT=5000

# The deployed frontend URL, so the API only accepts requests from your site.
# For local dev, keep the Vite dev server URL below.
CLIENT_ORIGIN=http://localhost:5173
